# Copy to .env at the project root. Keep .env out of Git.
# Leave empty to use the three deterministic demo lessons only.
OPENAI_API_KEY=
# Both models must support vision and Responses structured output.
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_DRAWING_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=12000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_DIMENSION=1280
AI_REQUESTS_PER_MINUTE=5
AI_MAX_CONCURRENT=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
